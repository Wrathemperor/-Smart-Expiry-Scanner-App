# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
python/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Editor & Tooling configurations
.vscode/
.idea/
.codeatlas/
*.swp
*.swo

# Database files (scoped to root /database directory to allow app/database/ source code)
/database/
*.db
*.sqlite
*.sqlite3

# Logs & Debugging directories
/logs/
*.log
/debug_ocr/

# Application Image Uploads (preserve folder structure with .gitkeep)
/app/images/*
!/app/images/.gitkeep

# Mobile application artifacts & backups
/apks/
*.apk
/New folder/
/New folder.zip
.gradle/
local.properties

# Windows binaries & Tesseract artifacts in root
*.exe
*.dll
*.1.html
*.5.html
*.zip
/doc/
/tessdata/

# Temporary / Scratch Files
temp_*
temp_small.jpg

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
