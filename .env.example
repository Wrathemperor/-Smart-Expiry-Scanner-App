# ShelfSense Gateway Server Environment Configuration Example
# Copy this file to .env and fill in your actual values.

# Google Gemini Vision API Key (recommended for OCR & product extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# OCR Provider: 'gemini' or 'bedrock'
OCR_PROVIDER=gemini

# AWS Bedrock Configuration (if OCR_PROVIDER=bedrock)
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Database Configuration (defaults to local SQLite database in database/shelfsense.db)
DATABASE_URL=sqlite:///./database/shelfsense.db
